{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["watchNamespaces"],
  "properties": {
    "watchNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      }
    },
    "mocDiscovery": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 }
          },
          "required": ["create", "name"]
        },
        "image": { "type": "string", "minLength": 1 },
        "evidenceClaim": { "type": "string", "minLength": 1 },
        "evidenceMountPath": { "type": "string", "pattern": "^/[^\\s]*$" }
      },
      "required": ["enabled", "name", "serviceAccount", "image", "evidenceClaim", "evidenceMountPath"]
    }
  }
}
