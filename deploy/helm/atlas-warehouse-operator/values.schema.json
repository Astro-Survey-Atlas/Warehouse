{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": ["watchNamespaces"],
  "properties": {
    "watchNamespaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      }
    }
  }
}
