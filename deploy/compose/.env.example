QUERY_PORT=8080
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=atlas-minio
MINIO_ROOT_PASSWORD=change-this-local-password
ES_USERNAME=
ES_PASSWORD=
SCANNER_IMAGE=ghcr.io/astro-survey-atlas/astro-atlas-scanner:0.1.0
