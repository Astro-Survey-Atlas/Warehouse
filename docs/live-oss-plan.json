{
  "version": 1,
  "source": {
    "connector": {
      "type": "oss",
      "endpoint": "http://oss-cn-hangzhou-zjy-d01-a.res.cloud.zhejianglab.com",
      "region": "cn-hangzhou-zjy-d01",
      "credentialRef": {
        "accessKeyEnv": "DATA_AND_COMPUTING_ACCESS",
        "secretKeyEnv": "DATA_AND_COMPUTING_SECRET"
      }
    },
    "location": {
      "bucket": "data-and-computing",
      "prefix": "projects/CSST/shared-data/euclid/aws-mirrors/q1/MER/102018212/VIS/"
    }
  },
  "filters": {
    "includeSuffixes": [".fits", ".fit"],
    "excludePatterns": []
  },
  "handlers": ["default", "fits", "coverage"],
  "modality": "image",
  "sink": {
    "connector": {
      "type": "elasticsearch",
      "endpoint": "http://127.0.0.1:19200",
      "credentialRef": {}
    }
  }
}
